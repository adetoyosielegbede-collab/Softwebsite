# Password for /admin. Required in production; locally it defaults to "softcom".
ADMIN_PASSWORD=

# Signs the admin session cookie. Defaults to a value derived from the password.
CMS_SECRET=

# "local" writes content/*.json and public/uploads on this machine (the default).
# "github" commits those files to a repository, which is what a Vercel deploy needs
# because its filesystem is read-only.
CMS_STORAGE=local

# Only used when CMS_STORAGE=github. Token needs "contents: write" on the repo.
# GITHUB_TOKEN=
# GITHUB_REPO=owner/name
# GITHUB_BRANCH=main

# Used for canonical links and social cards.
NEXT_PUBLIC_SITE_URL=http://localhost:4317

# Contact form. Without RESEND_API_KEY the live site refuses to pretend a message was sent.
# Verify softcom.xyz in Resend (SPF and DKIM), then set these on the Vercel project.
# RESEND_API_KEY=
# CONTACT_FROM=Softcom <contact@softcom.xyz>
# CONTACT_TO=contact@softcom.xyz
